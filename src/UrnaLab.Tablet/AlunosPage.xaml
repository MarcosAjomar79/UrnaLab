<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="UrnaLab.Tablet.AlunosPage"
    BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121826}"
    Title="Alunos">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="16">

        <!-- Cabeçalho -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto,Auto,Auto"
            ColumnSpacing="12">

            <VerticalStackLayout Spacing="2">

                <Label
                    Text="Alunos"
                    FontSize="28"
                    FontAttributes="Bold"
                    BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121826}"
                    TextColor="{AppThemeBinding Light=#0B1F5C, Dark=#E8EEFF}"/>

                <Label
                    Text="Gerencie os alunos cadastrados."
                    FontSize="15"
                    TextColor="#667085"/>

            </VerticalStackLayout>

            <Button
                Grid.Column="1"
                x:Name="btnNovoAluno"
                Text="+ NOVO"
                Clicked="btnNovoAluno_Click"
                FontAttributes="Bold"
                BackgroundColor="#0B1F5C"
                TextColor="White"
                CornerRadius="10"
                Padding="18,10"/>

            <Button
                Grid.Column="2"
                x:Name="btnEditarAluno"
                Text="EDITAR"
                Clicked="btnEditarAluno_Click"
                FontAttributes="Bold"
                BackgroundColor="Gray"
                TextColor="White"
                CornerRadius="10"
                Padding="18,10"/>

            <Button
                Grid.Column="3"
                x:Name="btnExcluirAluno"
                Text="EXCLUIR"
                Clicked="btnExcluirAluno_Click"
                FontAttributes="Bold"
                BackgroundColor="Red"
                TextColor="White"
                CornerRadius="10"
                Padding="18,10"/>


        </Grid>

        <!-- Pesquisa -->
        <Border
            Grid.Row="1"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1B2433}"
            Stroke="{AppThemeBinding Light=#D9E0E8, Dark=#344054}"
            StrokeThickness="1"
            Padding="4">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>

            <Entry
                x:Name="txtBuscarAluno"
                Placeholder="Buscar por nome ou RA"
                FontSize="16"
                TextColor="{AppThemeBinding Light=#667085, Dark=#E8EEFF}"
                ClearButtonVisibility="WhileEditing"
                TextChanged="txtBuscarAluno_TextChanged" />

        </Border>

        <!-- Lista -->
        <Border
            Grid.Row="2"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1B2433}"
            Stroke="{AppThemeBinding Light=#D9E0E8, Dark=#344054}"
            StrokeThickness="1"
            Padding="12">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <CollectionView
                x:Name="listaAlunos"
                SelectionMode="Single"
                SelectionChanged="listaAlunos_SelectionChanged">

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        Spacing="8"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">

                        <Label
                            Text="Nenhum aluno cadastrado"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light=#404756, Dark=#E8EEFF}"
                            HorizontalTextAlignment="Center"/>

                        <Label
                            Text="Toque em + NOVO para cadastrar."
                            FontSize="14"
                            TextColor="{AppThemeBinding Light=#7A8492, Dark=#E8EEFF}"
                            HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout Padding="10">

                            <Label
                                Text="{Binding Nome}"
                                FontSize="18"
                                FontAttributes="Bold"/>

                            <Label
                                Text="{Binding Ra}"
                                FontSize="14"/>

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Border>

    </Grid>

</ContentPage>