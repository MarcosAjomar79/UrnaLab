<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="UrnaLab.Tablet.PainelPage"
    BackgroundColor="#F5F7FA"
    Title="UrnaLab">

    <ScrollView>

        <VerticalStackLayout
            Padding="24"
            Spacing="24"
            MaximumWidthRequest="900"
            HorizontalOptions="Center">

            <Label
                Text="URNALAB"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="#0B1F5C"/>

            <Label
                Text="Painel Principal"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="#202631"/>

            <Label
                Text="Selecione uma opção para continuar."
                FontSize="16"
                TextColor="#667085"/>

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="16"
                RowSpacing="16">

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="ALUNOS"
                    Clicked="btnAlunos_Click"
                    HeightRequest="100"
                    FontSize="18"
                    FontAttributes="Bold"
                    BackgroundColor="White"
                    TextColor="#0B1F5C"
                    BorderColor="#D9E0E8"
                    BorderWidth="1"
                    CornerRadius="14"/>

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="CHAPAS"
                    Clicked="btnChapas_Click"
                    HeightRequest="100"
                    FontSize="18"
                    FontAttributes="Bold"
                    BackgroundColor="White"
                    TextColor="#0B1F5C"
                    BorderColor="#D9E0E8"
                    BorderWidth="1"
                    CornerRadius="14"/>

                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="RELATÓRIOS"
                    Clicked="btnRelatorios_Click"
                    HeightRequest="100"
                    FontSize="18"
                    FontAttributes="Bold"
                    BackgroundColor="White"
                    TextColor="#0B1F5C"
                    BorderColor="#D9E0E8"
                    BorderWidth="1"
                    CornerRadius="14"/>

                <Button
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="INICIAR VOTAÇÃO"
                    Clicked="btnIniciarVotacao_Click"
                    HeightRequest="100"
                    FontSize="18"
                    FontAttributes="Bold"
                    BackgroundColor="#0B1F5C"
                    TextColor="White"
                    CornerRadius="14"/>

            </Grid>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>