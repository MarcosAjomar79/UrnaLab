<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="UrnaLab.Tablet.VotacaoPage"
    BackgroundColor="#EEF1F5"
    Title="Votação">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="18"
            MaximumWidthRequest="700"
            HorizontalOptions="Center">

            <!-- CABEÇALHO -->

            <Label
                Text="VOTAÇÃO ESCOLAR"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                TextColor="#0B1F5C"/>

            <Label
                x:Name="lblAluno"
                Text="Carregando aluno..."
                FontSize="15"
                HorizontalTextAlignment="Center"
                TextColor="#667085"/>

            <!-- VISOR -->

            <Border
                Padding="20"
                BackgroundColor="White"
                Stroke="#CBD3DD"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="NÚMERO DA CHAPA"
                        FontSize="13"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="#667085"/>

                    <Label
                        x:Name="lblNumero"
                        Text="---"
                        FontSize="48"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="#202631"/>

                    <Label
                        x:Name="lblChapa"
                        Text="Digite o número da chapa"
                        FontSize="19"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="#0B1F5C"/>


                </VerticalStackLayout>
            </Border>

            <!-- TECLADO -->

            <!-- TECLADO -->

            <Grid
                RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnDefinitions="*,*,*"
                RowSpacing="10"
                ColumnSpacing="10">

                <!-- 1 2 3 -->

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="1"
                    CommandParameter="1"
                    Clicked="btnNumero_Click"
                    FontSize="26"
                    HeightRequest="65"/>

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="2"
                    CommandParameter="2"
                    Clicked="btnNumero_Click"
                    FontSize="26"
                    HeightRequest="65"/>

                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    Text="3"
                    CommandParameter="3"
                    Clicked="btnNumero_Click"
                    FontSize="26"
                    HeightRequest="65"/>

                <!-- 4 5 6 -->

                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="4"
                    CommandParameter="4"
                    Clicked="btnNumero_Click"
                    FontSize="26"
                    HeightRequest="65"/>

                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="5"
                    CommandParameter="5"
                    Clicked="btnNumero_Click"
                    FontSize="26"
                    HeightRequest="65"/>

                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    Text="6"
                    CommandParameter="6"
                    Clicked="btnNumero_Click"
                    FontSize="26"
                    HeightRequest="65"/>

                <!-- 7 8 9 -->

                <Button
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="7"
                    CommandParameter="7"
                    Clicked="btnNumero_Click"
                    FontSize="26"
                    HeightRequest="65"/>

                <Button
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="8"
                    CommandParameter="8"
                    Clicked="btnNumero_Click"
                    FontSize="26"
                    HeightRequest="65"/>

                <Button
                    Grid.Row="2"
                    Grid.Column="2"
                    Text="9"
                    CommandParameter="9"
                    Clicked="btnNumero_Click"
                    FontSize="26"
                    HeightRequest="65"/>

                <!-- 0 -->

                <Button
                    Grid.Row="3"
                    Grid.Column="1"
                    Text="0"
                    CommandParameter="0"
                    Clicked="btnNumero_Click"
                    FontSize="26"
                    HeightRequest="65"/>

            </Grid>

            <!-- CORRIGE / CONFIRMA -->

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12">

                <Button
                    Grid.Column="0"
                    Text="CORRIGE"
                    Clicked="btnCorrige_Click"
                    HeightRequest="60"
                    FontSize="17"
                    FontAttributes="Bold"
                    BackgroundColor="#F59E0B"
                    TextColor="Black"
                    CornerRadius="10"/>

                <Button
                    x:Name="btnConfirmar"
                    Grid.Column="1"
                    Text="CONFIRMA"
                    Clicked="btnConfirmar_Click"
                    IsEnabled="False"
                    HeightRequest="60"
                    FontSize="17"
                    FontAttributes="Bold"
                    BackgroundColor="#16A34A"
                    TextColor="White"
                    CornerRadius="10"/>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>