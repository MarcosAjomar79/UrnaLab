<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="UrnaLab.Tablet.MainPage"
    BackgroundColor="#F5F7FA"
    Title="UrnaLab">

    <Grid 
        Padding="24">                                                       

        <VerticalStackLayout
            Spacing="28"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            MaximumWidthRequest="520">

            <Label
                Text="URNALAB"
                FontSize="40"
                FontAttributes="Bold"
                TextColor="#0B1F5C"
                HorizontalTextAlignment="Center"/>

            <Label
                Text="Simulação Eleitoral Escolar"
                FontSize="18"
                TextColor="#5A6472"
                HorizontalTextAlignment="Center"/>

            <Button
                x:Name="btnIniciar"
                Text="INICIAR"
                Clicked="btnIniciar_Click"
                FontSize="20"
                FontAttributes="Bold"
                HeightRequest="60"
                MinimumWidthRequest="260"
                BackgroundColor="#0B1F5C"
                TextColor="White"
                CornerRadius="12"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>